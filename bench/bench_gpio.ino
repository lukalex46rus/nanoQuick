#include "src/hw/Pin.h"

// ============================================================================
// bench_gpio — toggle D13 (встроенный LED на Nano).
// Платформа: ATmega328P/328, Nano. Контекст: main.
// Ожидание: LED мигает с частотой loop() (визуально ~непрерывно).
// ============================================================================
using Led = hw::board::D13;

void setup() { Led::init(hw::Dir::Out); }
void loop()  { Led::toggle(); }